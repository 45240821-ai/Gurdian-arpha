# ── これは見本です。実際の値は Replit の Secrets（VPS では .env）に入れてください ──
# このファイルに本物のトークンを書いてコミットしないこと。

# 必須（段階1から）
BOT_TOKEN=
CLIENT_ID=
OWNER_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 任意
PORT=3000
# テスト用サーバーのID。設定すると deploy-commands.js がそのサーバーだけに登録する
DEV_GUILD_ID=

# 段階3（翻訳）から必須
DEEPL_TOKEN=

# 段階3（AIレビュー）・段階4（/ask）から必須
ANTHROPIC_API_KEY=

# 段階5（ダッシュボード）から必須
CLIENT_SECRET=
OAUTH_REDIRECT_URI=
SESSION_SECRET=
